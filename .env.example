# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google Sheets (via Google Service Account) ───────────────
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Python microservice (InBody parser, Google Sheets sync) ──
# Self-hosted FastAPI — see /supabase for context
PYTHON_API_BASE_URL=https://your-python-api.example.com

# ─── Admin ───────────────────────────────────────────────────
# Secret key required by the external lives/gamification API
ADMIN_LIVES_KEY=your-admin-key

# ─── Coach contact ───────────────────────────────────────────
# WhatsApp number with country code, no + or spaces (e.g. 521234567890)
NEXT_PUBLIC_COACH_WHATSAPP=521234567890
